# Copy to backend/.env
OPENROUTER_API_KEY=
ROUTER_MODEL=qwen/qwen-2.5-7b-instruct
EXTRACT_MODEL=openai/gpt-4.1-mini
ANSWER_MODEL=anthropic/claude-sonnet-5.5
DATABASE_URL=postgresql://plant:plant@localhost:5433/plantdocs
ANALYTICS_DATABASE_URL=postgresql://analytics_reader:analytics_reader@localhost:5433/plantdocs
EMBED_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATES=20
# Cross-encoder score floor: below this after reranking, fall back to all indexes / "not found"
MIN_RERANK_SCORE=-3.0
